{
  "name": "bilibili-hot100-launcher",
  "version": "2.0.0",
  "description": "Safe cross-platform launcher for the Vue and FastAPI services with verified PID management.",
  "author": "AI Assistant",
  "license": "MIT",
  "platforms": ["windows", "macos", "linux"],
  "languages": ["zh", "en"],
  "triggers": {
    "keywords": [
      "启动项目", "运行项目", "start project", "run project",
      "打开bilibili", "run bilibili", "启动bilibili",
      "启动前端", "启动后端", "start frontend", "start backend",
      "怎么运行", "how to run", "如何启动"
    ],
    "patterns": [
      "(?:启动|运行|打开|start|run).*?(?:bilibili|项目|project|frontend|backend|前端|后端)",
      "(?:怎么|如何|how to).*?(?:运行|启动|run|start)"
    ]
  },
  "actions": {
    "windows": {
      "command": ".\\start-all.bat --detached",
      "shell": "powershell"
    },
    "macos": {
      "command": "./start-all.sh --detached",
      "shell": "bash"
    },
    "linux": {
      "command": "./start-all.sh --detached",
      "shell": "bash"
    }
  },
  "services": {
    "frontend": {
      "port": 3000,
      "url": "http://127.0.0.1:3000",
      "framework": "Vue3 + TypeScript + Vite"
    },
    "backend": {
      "port": 8000,
      "url": "http://127.0.0.1:8000",
      "docs": "http://127.0.0.1:8000/docs",
      "framework": "Python + FastAPI"
    }
  },
  "requirements": {
    "windows": ["PowerShell 5.1+", "Python 3.9+", "Node.js 22.12+"],
    "macos": ["Bash", "Python 3.9+", "Node.js 22.12+"],
    "linux": ["Bash", "Python 3.9+", "Node.js 22.12+"]
  },
  "project_structure": {
    "frontend": "bilibili-hot100-vue3-ts",
    "backend": "bilibili-hot100-backend"
  }
}
